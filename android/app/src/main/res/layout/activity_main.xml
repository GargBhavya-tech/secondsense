<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ss_bg">

    <androidx.camera.view.PreviewView
        android:id="@+id/preview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/controls" />

    <!-- Debug HUD overlay: proves frames are arriving + shows the nearest cue.
         This is a dev aid; the real user output is audio + haptics. -->
    <TextView
        android:id="@+id/hud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:padding="10dp"
        android:background="@color/ss_hud_scrim"
        android:fontFamily="monospace"
        android:textColor="@color/ss_accent"
        android:textSize="13sp"
        android:text="@string/hud_booting"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- #23: confidence-tier badge (WHITE/BLUE/RED) shown at a glance next to the HUD. -->
    <View
        android:id="@+id/tierBadge"
        android:layout_width="14dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="#33FFFFFF"
        app:layout_constraintTop_toTopOf="@id/hud"
        app:layout_constraintBottom_toBottomOf="@id/hud"
        app:layout_constraintStart_toEndOf="@id/hud" />

    <!-- #30 laptop dashboard: QR + URL for a judge/demo-partner's laptop to join the live
         telemetry view over the local network. Purely a spectator aid — the blind user
         never needs this, so it's tucked in the top-right, out of the way of the controls. -->
    <ImageView
        android:id="@+id/dashboardQr"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:layout_margin="12dp"
        android:background="@color/ss_hud_scrim"
        android:contentDescription="@string/dashboard_qr_desc"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/dashboardUrl"
        android:layout_width="90dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:background="@color/ss_hud_scrim"
        android:fontFamily="monospace"
        android:gravity="center"
        android:textColor="@color/ss_accent"
        android:textSize="9sp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/dashboardQr"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@color/ss_panel"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:textColor="@color/ss_text"
            android:text="@string/mode_scan_seek" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchSonify"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:textColor="@color/ss_text"
            android:text="@string/sonify" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchCenterCrop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:textColor="@color/ss_text"
            android:text="@string/flow_center_crop" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCalibrate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/calibrate" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFind"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/find_voice" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDebugPanel"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/debug_panel" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTestTone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="@string/test_tone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTestBuzz"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/test_buzz" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
