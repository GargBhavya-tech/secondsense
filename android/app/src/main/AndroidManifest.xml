<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Live camera frame stream (build-map #6) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Primary haptic channel (Bible §5.2) — no runtime permission needed,
         but declared for clarity -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Voice goal-seeking (#26): short spoken command capture in scan/seek mode -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Phase 4 "call <contact>" voice task: look up a name and place the call. Requested at
         runtime, only the first time the user actually asks to call someone. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- #30 laptop dashboard: Android requires INTERNET for ANY socket use, even a server
         that only ever answers requests on the phone's own local Wi-Fi/hotspot. No actual
         internet access is used or needed (Bible §16 / #31 airplane-mode demo). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Some ROMs (incl. MIUI) restrict NetworkInterface enumeration without these declared,
         even though raw socket use alone doesn't formally require them — DashboardServer's
         localIpAddress() needs to actually see the Wi-Fi/hotspot interface's address. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="true" />

    <!-- ARCore (Path B room map): needs OpenGL ES 3.0. AR itself is optional (see the
         com.google.ar.core meta-data below) so the app still installs on non-AR devices. -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <!-- Android 11+ package visibility: lets AndroidSpeechRecognizer see the system
         RecognitionService for the built-in (interim) voice ASR path. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.SecondSense">

        <!-- QNN / Hexagon NPU: on Android 12+ an app must declare the vendor FastRPC libs it
             dlopen()s to reach the cDSP, or the transport setup fails (QnnDsp err 4000).
             required=false so non-QNN devices / the TFLITE build still install. -->
        <uses-native-library android:name="libcdsprpc.so" android:required="false" />
        <uses-native-library android:name="libadsprpc.so" android:required="false" />
        <uses-native-library android:name="libsdsprpc.so" android:required="false" />

        <!-- ARCore: "optional" = install on any device; RoomScanActivity gates at runtime via
             ArCoreApk.checkAvailability(). "required" would block install on non-AR phones. -->
        <meta-data android:name="com.google.ar.core" android:value="optional" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Dev-only bring-up screen: isolate YOLO/depth/audio/haptic one at a time.
             Not launcher-visible; opened only via a button in MainActivity. -->
        <activity
            android:name=".ui.DebugActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- Path B: deliberate "walk your room once" scan. Isolated activity — owns the camera
             via ARCore, separate from the live-nav CameraX pipeline. Opened from MainActivity. -->
        <activity
            android:name=".ar.RoomScanActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- "Classic" build: the exact pre-AI-integration MainActivity (commit 4ec5339) —
             camera + YOLO/depth + sonification + hazards + closed-vocab voice goal-seek, no
             IntentInterpreter / LLM / context auto-detect. Opened from the admin panel. -->
        <activity
            android:name=".ui.ClassicActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden" />
    </application>
</manifest>
