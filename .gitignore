# --- Python (laptop model-conversion pipeline) ---
secondsense-venv/
venv/
.venv/
__pycache__/
*.pyc

# --- Generated / large artifacts ---
export_assets/*
!export_assets/.gitkeep
!export_assets/README.md
logs/*
!logs/.gitkeep
conversion_manifest.json
*.zip
.dist/

# --- Model checkpoints (download from Ultralytics, or produced by convert.py) ---
*.pt

# --- On-device model weights — NEVER commit (GitHub 100 MB limit; side-loaded per README) ---
